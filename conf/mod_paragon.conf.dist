[worldserver]

########################################
# Mod Paragon configuration
########################################
#
#    Paragon.Enable
#        Description: Enable Mod Paragon
#        Default:     1 - Enabled
#                     0 - Disabled
#

Paragon.Enable = 1

########################################
# Spell / Aura IDs
########################################
#
#    Paragon.IdLevel            Level marker aura (also the "has paragon" flag).
#                               Its stack is shown to the client capped at 255;
#                               the true level (up to MaxLevel) is tracked in
#                               the DB / cache.
#    Paragon.MountSpeedSpellId  Server-side Mount Speed aura (run + swim speed),
#                               applied once with the full value (no stacking).
#
#    Stats are applied directly via the core stat APIs (no per-stat aura IDs).
#    The Lua/AIO layer casts the reapply-trigger spell 100028 after a point
#    allocation; that link lives in spell_script_names (DB), not here.
#

Paragon.IdLevel           = 100000
Paragon.MountSpeedSpellId  = 100029

########################################
# Points per Level
########################################

Paragon.PPL = 5

########################################
# Max Level (0 = no limit)
########################################

Paragon.MaxLevel = 666

########################################
# XP Rewards
########################################

Paragon.XPElite             = 1
Paragon.XPWorldBoss         = 20
Paragon.XPDungeonElite      = 1
Paragon.XPDungeonBoss       = 3
Paragon.XPHCDungeonElite    = 2
Paragon.XPHCDungeonBoss     = 5
Paragon.XPRaidBoss          = 10
Paragon.XPQuest             = 3

# Reduces XP in party/raid. XP = XP/PlayerCount
Paragon.XPPartyReduce = 0

########################################
# Max Points per Stat (default: 666)
########################################
#
#    Maximum number of points a player can allocate into each
#    individual paragon stat.  Set to 0 for no limit.
#

Paragon.MaxStr        = 666
Paragon.MaxInt        = 666
Paragon.MaxAgi        = 666
Paragon.MaxSpi        = 666
Paragon.MaxSta        = 666
Paragon.MaxHaste      = 666
Paragon.MaxArmorPen   = 666
Paragon.MaxSpellPower = 666
Paragon.MaxCrit       = 666
Paragon.MaxHit        = 666
Paragon.MaxBlock      = 666
Paragon.MaxExpertise  = 666
Paragon.MaxParry      = 666
Paragon.MaxDodge      = 666
Paragon.MaxMountSpeed = 666
Paragon.MaxManaRegen  = 666
Paragon.MaxLifeLeech  = 666

########################################
# Life Leech
########################################

# Percentage of damage healed per Life Leech point.
# Example: 0.1 = 0.1% per point, so 100 points = 10% life leech
Paragon.LifeLeechPct = 0.1
